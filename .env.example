# No secrets belong here. First-run bootstrap reads the password via stdin.
# Published image; pin a release tag or digest for predictable upgrades.
INVENTROSPECT_IMAGE=ghcr.io/sigmatechnica/inventrospect:latest
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
MCP_PORT=8081
# Set true when browsers reach the service through HTTPS.
SECURE_COOKIES=false
# Keep below Compose stop_grace_period (30s); adjust both for longer drains.
SHUTDOWN_TIMEOUT=15s
# Data and backups use Compose named volumes at /data and /backups.
# No public/base URL is needed. MCP reaches REST at http://app:8080.
# Logs are operational UTC stderr logs; no configurable log level or telemetry.
